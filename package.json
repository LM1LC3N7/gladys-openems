{
  "name": "gladys-openems",
  "version": "0.1.1",
  "private": true,
  "description": "FENECON FEMS and OpenEMS storage systems for Gladys Assistant: state of charge, powers, production, grid, lifetime energy counters, system state and a production index, read locally through the JSON-RPC WebSocket API of the Edge. Read-only.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs cover.png"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LM1LC3N7/gladys-openems.git"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "license": "Apache-2.0"
}
